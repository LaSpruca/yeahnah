struct Option<T> {
    bool present;

    union {
        T value;
        void *absent;
    } inner;
}

Option<T> Option<T>.none() <T> {
    var Option<T> value = {
        .present = false,
        .inner = {
            .absent = NULL
        }
    };

    return value;
}

Option<T> Option<T>.some(T inner) <T> {
    var Option<T> value = {
        .present = true,
        .inner = {
            .value = inner
        }
    };

    return value;
}

T  value(for Option<T> self) <T> {
    return self.inner.value;
}

Option<U> map(for Option<T> self, Function<(T), U> *map) <T, U> {
    return self.present ? map(self.inner.value) : Option<U>.none();
}
